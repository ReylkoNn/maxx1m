# Max1m Backend Configuration
# Copy this file to .env and fill in the values

# Required: Secret key for JWT signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: Path to data directory (default: ~/.max1m)
# MAX1M_DATA_DIR=/path/to/data

# Maximum authenticated uploads handled simultaneously by each backend process.
# Does not limit total connections, workers, disk usage, or slow clients.
# MAX_CONCURRENT_UPLOADS_PER_PROCESS=8

# Per-account device registration quotas enforced atomically on new device login.
# MAX_ACTIVE_DEVICES_PER_USER=32
# MAX_TOTAL_DEVICES_PER_USER=256

# TTL (seconds) for unfinished upload reservations that have NOT published a blob on disk.
# Reservations with a linked blob on disk are never reaped automatically.
# UPLOAD_RESERVATION_TTL_SECONDS=86400

# Optional server-side Ed25519 signature verification for experimental prekey bundles.
# REQUIRE_SIGNED_PREKEY_VERIFICATION=false

# Retention horizon (seconds) for acknowledged personal message ciphertexts before
# compacting them into lightweight SHA-256 idempotency tombstones (0 disables compaction).
# DELIVERED_MESSAGE_RETENTION_SECONDS=604800
# IDEMPOTENCY_TOMBSTONE_TTL_SECONDS=7776000

# Per-account encrypted file storage quotas and retention horizon (seconds; 0 disables TTL pruning).
# MAX_STORED_FILES_PER_USER=2000
# MAX_STORED_BYTES_PER_USER=2147483648
# MAX_GRANTS_PER_FILE=200
# UPLOADED_FILE_RETENTION_SECONDS=2592000

# Per-IP HTTP rate limits for personal message relay and sync/ack endpoints.
# RATE_LIMIT_MESSAGE_SEND=240/minute
# RATE_LIMIT_MESSAGE_SYNC=240/minute

# Set to false once all clients pass WebSocket Bearer tokens via Authorization header
# so tokens cannot appear in query strings (?token=...).
# ALLOW_LEGACY_WS_QUERY_TOKEN=true

# Comma-separated reverse-proxy IPs or CIDRs trusted to supply X-Forwarded-For / X-Real-IP
# (e.g. 127.0.0.1,::1). Empty (default) ignores forwarded IP headers completely.
# TRUSTED_PROXY_IPS=

# Expose interactive Swagger/ReDoc OpenAPI endpoints (/docs, /redoc, /openapi.json).
# Disabled by default on production relay nodes.
# ENABLE_API_DOCS=false

# Require every newly registered/logged-in device key to be a canonical 32-byte
# Ed25519 public key whose fingerprint matches SHA-256(public_key).
# (Mismatched colon-formatted SHA-256 fingerprints are always rejected.)
# REQUIRE_VERIFIED_DEVICE_KEYS=false

# Anti-surveillance coarsening window (seconds) for Device.last_seen timestamps.
# Default 3600 (1 hour); set to 86400 for day-level buckets or 0 to disable updates after creation.
# LAST_SEEN_GRANULARITY_SECONDS=3600

# Production X3DH PreKey directory (mandatory Ed25519 signature verification & OPK quotas).
# ENABLE_PREKEYS=true

# Self-hosted STUN / coturn REST ephemeral HMAC-SHA1 configuration (VPN-free WebRTC in RU).
# Include turns:<host>:443?transport=tcp so voice & screen sharing traverse DPI/firewalls on TCP/TLS 443:
# CALL_STUN_URLS=stun:turn.company.ru:3478
# CALL_TURN_URLS=turn:turn.company.ru:3478?transport=udp,turn:turn.company.ru:3478?transport=tcp,turns:turn.company.ru:443?transport=tcp
# CALL_TURN_SHARED_SECRET=
# CALL_TURN_CREDENTIAL_TTL_SECONDS=3600
# CALL_FORCE_RELAY_RECOMMENDED=false
# MAX_GROUP_VOICE_PEERS=8


